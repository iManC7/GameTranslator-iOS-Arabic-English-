<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: sistemin açılış ekranı (simge daire içinde gösterilir). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/gt_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@color/gt_background</item>
        <item name="android:statusBarColor">@color/gt_background</item>
        <item name="android:navigationBarColor">@color/gt_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/gt_background</item>
        <item name="android:statusBarColor">@color/gt_background</item>
        <item name="android:navigationBarColor">@color/gt_background</item>
    </style>
</resources>
