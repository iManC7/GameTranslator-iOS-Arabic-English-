<UserControl x:Class="GameTranslator.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GameTranslator.App.Controls"
             xmlns:t="clr-namespace:GameTranslator.App.Theme"
             Background="Transparent" Foreground="{DynamicResource textPrimaryBrush}">
    <UserControl.Resources>
        <!-- Seçim kartları: düğme kendi çerçevesini çizmez, kart tüm genişliğe yayılır. -->
        <Style x:Key="PlainCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- ========================================================= -->
        <!-- ÜST BAŞLIK: Logo, Başlık, Adım Rozeti & Kapat Butonu      -->
        <!-- ========================================================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource accentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Kurulum" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="Birkaç dakikalık, bir kerelik iş" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource accentSoftBrush}" CornerRadius="12" Padding="10,3" Margin="0,0,10,0">
                            <TextBlock x:Name="StepBadgeText" Text="Adım 1 / 5" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 4 Kademeli Adım Çubuğu (Apple Kapsül Butonlar) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Pill1" Grid.Column="0" Click="OnPill1" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar1" Height="4" CornerRadius="2" Background="{DynamicResource accentBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText1" Text="Hoş geldin" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource accentTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Pill2" Grid.Column="2" Click="OnPill2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar2" Height="4" CornerRadius="2" Background="{DynamicResource hairlineBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText2" Text="PS5" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Pill3" Grid.Column="4" Click="OnPill3" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar3" Height="4" CornerRadius="2" Background="{DynamicResource hairlineBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText3" Text="TV" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Pill4" Grid.Column="6" Click="OnPill4" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar4" Height="4" CornerRadius="2" Background="{DynamicResource hairlineBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText4" Text="Dene" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- ALT ÇUBUK: Geri, Ana Ekrana Geç, Devam Et                 -->
        <!-- ========================================================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Button x:Name="BackButton" Content="← Geri" Click="OnBack" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinWidth="90" MinHeight="34" />
                <Button x:Name="SkipButton" Content="Şimdilik atla" Click="OnSkipToMain" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" MinHeight="34" Padding="14,0" />
                <Button x:Name="NextButton" Content="Devam Et " Click="OnNext" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" MinWidth="110" MinHeight="34">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- ADIM İÇERİKLERİ                                           -->
        <!-- ========================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0B0E14" Padding="28,20">
            <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                <!-- ==================== ADIM 1: BAŞLANGIÇ ==================== -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource accentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="500">
                            <TextBlock Text="GameTranslator'a hoş geldin" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="PS5 oyunlarındaki İngilizce altyazıları ekrandan okur ve TV'nde anında Türkçe gösterir." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Gerekenler" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Gereksinim 1 -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PS5" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                                <TextBlock Text="Açık ve bu bilgisayarla aynı ağda olsun." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Gereksinim 2 -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static c:Glyphs.Tv}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TV ya da monitör" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                                <TextBlock Text="Samsung, LG veya Android TV. TV yoksa çeviri bilgisayar ekranında da gösterilebilir." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Gereksinim 3 -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static c:Glyphs.People}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="İkinci bir PSN hesabı (ücretsiz)" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                                <TextBlock Text="Bilgisayar bu hesapla bağlanır, böylece senin oyunun ve kumandan etkilenmez." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== ADIM 2: PS5 KONSOLU & EŞLEŞTİRME ==================== -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource accentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PS5'i bağla" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="İkinci hesapla giriş yap, sonra PS5'teki kodu gir. Bir kere yapılır." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- BİLGİ KARTI: TEK SEFERLİK KURULUM VE SESSİZ ARKA PLAN ÇALIŞMASI -->
                    <Border Background="#101726" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Sonrasında uygulama PS5'e kendisi bağlanır; başka bir şey açman gerekmez." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                        </Grid>
                    </Border>

                    <!-- KART 1: PSN HESAP GİRİŞİ (2. Kullanıcı Hesabı) -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource accentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="1. İkinci hesapla giriş yap" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                <Button Content="Kodu elle yapıştır" Click="OnToggleManualPsnCode" HorizontalAlignment="Right" Style="{StaticResource PillButton}" />
                            </Grid>

                            <TextBlock Text="Şifren doğrudan Sony'nin sayfasına gider, uygulama görmez." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" LineHeight="15" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PsnSignInButton" Content="PSN girişini aç" Click="OnOpenSonyLogin" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="16,8" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock Grid.Column="1" x:Name="PsnStatusText" Text="Düğmeye bas, açılan sayfada giriş yap." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                            </Grid>

                            <!-- Alternatif Kod / Token Girişi (İsteğe bağlı açılır) -->
                            <Border x:Name="ManualPsnCard" Background="{DynamicResource wellBrush}" CornerRadius="6" Padding="10" Margin="0,4,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Tarayıcıdaki adresi (code=... içeren) buraya yapıştır:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Content="Giriş sayfası" Click="OnOpenExternalSonyBrowser" HorizontalAlignment="Right" Style="{StaticResource PillButton}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PsnCodeInput" MinHeight="28" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Margin="0,0,6,0" ToolTip="Yönlendirme linkini veya code=... değerini yapıştırın" />
                    <Button x:Name="PsnVerifyButton" Grid.Column="1" Content="Doğrula" Click="OnVerifyPsnCode" Style="{StaticResource PillButton}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- KART 2: PS5 KONSOLUNU EŞLEŞTİRME -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="2. PS5 ile eşleştir" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="PS5'te ikinci hesaptayken: Ayarlar › Sistem › Uzaktan Oynatma › Cihaz Eşleştir. Ekranda 8 haneli bir kod çıkar." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="16" />

                            <!-- Konsol IP Seçimi & Arama -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PS5 adresi:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource textPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" x:Name="Ps5HostInput" Text="" MinHeight="32" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="13" Padding="8,4" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Ağda Ara" Click="OnScanPs5" Style="{StaticResource PillButton}" />
                            </Grid>

                            <!-- 8 Haneli PIN Kodu -->
                            <Border Background="{DynamicResource wellBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Ekrandaki 8 haneli kod:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource accentTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBox x:Name="Ps5PinInput" Text="" MinHeight="42" Width="220" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="18" FontWeight="Bold" TextAlignment="Center" MaxLength="8" Padding="4" />
                                </StackPanel>
                            </Border>

                            <!-- BÜYÜK BİRİNCİL EŞLEŞTİR BUTONU -->
                            <Button x:Name="PairButton" Click="OnPairPs5" Background="{DynamicResource successBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" MinHeight="46" FontSize="15" Cursor="Hand" Margin="0,0,0,6">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Eşleştir " VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="PairStatusText" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource successBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

                            <!-- Alternatif: Yakalama Kartı (Capture Card) / OBS Kullanıcıları İçin -->
                            <Border Background="#101726" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Yakalama kartı ya da OBS mi kullanıyorsun?" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="O zaman eşleştirme gerekmez; görüntü karttan veya OBS'ten alınır." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                  <Button Grid.Column="1" Content="Bunu seç " Click="OnSkipPs5ForCaptureCard" Style="{StaticResource PillButton}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== ADIM 3: AKILLI TV ==================== -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource successSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Çeviri nerede görünsün?" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="TV'ni seç. TV yoksa bilgisayar ekranını seç." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Platform Seçim Kartları (Tıklanabilir Butonlar) -->
                    <StackPanel Margin="0,0,0,14">
                        <!-- 1. PC & OBS -->
                        <Button Click="OnSelectTvPc" Style="{StaticResource PlainCardButton}" Margin="0,0,0,8">
                            <Border x:Name="TvBorderPc" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource accentBrush}" BorderThickness="2" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Bilgisayar ekranı" FontWeight="Bold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="Monitörde oynuyorsan ya da OBS ile yayın yapıyorsan." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgePc" Grid.Column="2" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="Seçildi" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 2. Samsung Smart TV -->
                        <Button Click="OnSelectTvSamsung" Style="{StaticResource PlainCardButton}" Margin="0,0,0,8">
                            <Border x:Name="TvBorderSamsung" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Samsung TV" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="2018 ve sonrası modeller." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgeSamsung" Grid.Column="2" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="Seçildi" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 3. LG webOS TV -->
                        <Button Click="OnSelectTvLg" Style="{StaticResource PlainCardButton}" Margin="0,0,0,8">
                            <Border x:Name="TvBorderLg" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="LG TV" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="webOS işletim sistemli modeller." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgeLg" Grid.Column="2" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="Seçildi" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 4. Android TV / Google TV -->
                        <Button Click="OnSelectTvAndroid" Style="{StaticResource PlainCardButton}">
                            <Border x:Name="TvBorderAndroid" Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Android TV / Google TV" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                        <TextBlock Text="TCL, Philips, Xiaomi, Sony ve TV kutuları." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgeAndroid" Grid.Column="2" Background="{DynamicResource successSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="Seçildi" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource successBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- Seçilen Platform Detay Paneli -->
                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <!-- Panel: PC / OBS -->
                            <StackPanel x:Name="TvDetailPc" Visibility="Visible">
                                <TextBlock Text="Bilgisayar ekranı seçildi" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource successBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="TV kurman gerekmez. OBS kullanıyorsan şu adresi tarayıcı kaynağı olarak ekle:" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="http://localhost:8787/obs" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource accentTextBrush}" VerticalAlignment="Center" />
                  <Button Content="Adresi kopyala" HorizontalAlignment="Right" Click="OnCopyObsUrl" Style="{StaticResource PillButton}" />
                                </Grid>
                            </StackPanel>

                            <!-- Panel: Samsung Tizen TV -->
                            <StackPanel x:Name="TvDetailSamsung" Visibility="Collapsed">
                                <TextBlock Text="Samsung TV" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource accentTextBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="TV'nin adresini yaz, sonra TV'de GameTranslator'ı aç:" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SamsungHostInput" Text="192.168.1.108" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="13" />
                                    <Button Grid.Column="1" Content="Kaydet" Click="OnSaveSamsung" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="12,4" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                  <Button Content="TV uygulama dosyası" Click="OnOpenSamsungWgt" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
                  <Button Content="TV Kurulum Rehberi (PDF)" Click="OnOpenGuidePdf" Style="{StaticResource PillButton}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Panel: LG webOS TV -->
                            <StackPanel x:Name="TvDetailLg" Visibility="Collapsed">
                                <TextBlock Text="LG TV" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource accentTextBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="TV'nin adresini yaz. TV onay isterse kumandayla kabul et:" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LgHostInput" Text="192.168.1.108" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="13" />
                                    <Button Grid.Column="1" Content="Bağlan" Click="OnSaveLg" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="12,4" />
                                </Grid>
                <Button Content="TV uygulama dosyası" Click="OnOpenLgIpk" Style="{StaticResource PillButton}" HorizontalAlignment="Left" />
                            </StackPanel>

                            <!-- Panel: Android TV -->
                            <StackPanel x:Name="TvDetailAndroid" Visibility="Collapsed">
                                <TextBlock Text="Android TV" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource accentTextBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="TV'nin adresini yaz ya da ara, sonra uygulamayı tek tıkla kur:" FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AndroidHostInput" Text="" MinHeight="34" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="13" />
                  <Button x:Name="ScanAndroidTvButton" Grid.Column="1" Content="TV Ara" Click="OnScanAndroidTv" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
                  <Button Grid.Column="2" Content="Sadece kaydet" Click="OnSaveAndroid" Style="{StaticResource PillButton}" />
                                </Grid>

                                <!-- TEK TIKLA ADB İLE KURMA BUTONU -->
                                <Button x:Name="AndroidInstallButton" Content="TV'ye kur ve aç" Click="OnInstallAndroidApp" Background="{DynamicResource successBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" MinHeight="38" FontSize="15" Cursor="Hand" Margin="0,0,0,8">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- ADB Durum ve Yönerge Paneli -->
                                <Border Background="{DynamicResource wellBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Kurulum çalışmazsa:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource accentTextBrush}" Margin="0,0,0,3" />
                                        <TextBlock Text="• TV'de Ayarlar › Cihaz Tercihleri › Hakkında › Yapı Numarası'na 7 kez bas." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,2" />
                                        <TextBlock Text="• Geliştirici Seçenekleri'nde 'USB / Ağ hata ayıklama'yı aç." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock x:Name="AndroidInstallStatus" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource accentTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                  <Button Content="TV uygulama dosyası" Click="OnOpenAndroidApk" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
                  <Button Content="TV Kurulum Rehberi (PDF)" Click="OnOpenGuidePdf" Style="{StaticResource PillButton}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="TvStatusFeedback" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource successBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== ADIM 4: TEST & BİTTİ ==================== -->
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource successSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource accentTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hazırsın!" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="Bundan sonra sadece başlat düğmesine basman yeter." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource cardBrush}" BorderBrush="{DynamicResource hairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Nasıl kullanılır?" FontWeight="Bold" FontSize="15" Foreground="White" Margin="0,0,0,10" />
                            <TextBlock Text="1. Oyunda altyazıları aç." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="2. Ana ekrandaki büyük düğmeyle çeviriyi başlat." FontSize="13" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="3. TV'de GameTranslator'ı aç; çeviri oyunun üstünde görünür." FontSize="13" Foreground="{DynamicResource successBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Ekranda dene" Click="OnTestDesktopOverlay" Style="{StaticResource PillButton}" MinHeight="36" FontWeight="SemiBold" />
            <Button Grid.Column="2" Content="TV'de dene" Click="OnTestTv" Style="{StaticResource PillButton}" MinHeight="36" FontWeight="SemiBold" />
                    </Grid>

                    <Button Content="Ana ekrana geç" Visibility="Collapsed" Click="OnSkipToMain" Background="{DynamicResource accentBrush}" Foreground="White" FontWeight="Bold" FontSize="15" BorderThickness="0" MinHeight="42" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
